# =============================================================================
#  telecom-zero-rating-lab — repository .gitignore
#  Tree-wide rules for the combined repo (both labs). Per-lab .gitignore files
#  remain as a second layer.
# =============================================================================

# --- Lab run artefacts (regenerated every run; keep evidence out of git) -----
**/logs/
*.jsonl
*.pcap
**/_*.out

# --- Local TLS material (throwaway self-signed; never commit a private key) ---
**/certs/
*.pem
*.key
*.crt
*.p12
*.pfx

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments (large; never commit) -------------------------------
.venv/
**/.venv/
venv/
env/
ENV/

# --- Tooling caches -----------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors / OS -------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
