# =============================================================================
#  zero-rating-detection-lab — .gitignore
# =============================================================================

# --- Lab run artefacts -------------------------------------------------------
# Every run regenerates these. They also contain a (fictional) MSISDN/IMSI and
# per-flow records, so keeping them out of version control is the right habit
# to have even when the data is synthetic.
logs/
*.jsonl

# --- Local TLS material ------------------------------------------------------
# certs/ holds the throwaway self-signed keypair the lab origin generates on
# first run. A private key must never be committed, even a disposable one.
certs/
*.pem
*.key
*.crt
*.p12
*.pfx

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Tooling caches ----------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
